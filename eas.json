{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "REPLACE_WITH_YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "REPLACE_WITH_YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "REPLACE_WITH_YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
      }
    }

  },
  "submit": {
    "production": {}
  }
}
